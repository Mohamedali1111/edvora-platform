{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/test-runner.ts",
    "src/**/*.test.ts",
    "src/features/auth/error-mapping.ts",
    "src/features/auth/token-store.ts",
    "src/features/auth/validate.ts",
    "src/features/courses/content-access-recovery.ts",
    "src/features/courses/course-types.ts",
    "src/features/courses/error-mapping.ts",
    "src/features/courses/format.ts",
    "src/features/courses/lesson-type-routing.ts",
    "src/features/courses/pagination.ts",
    "src/features/courses/progress-labels.ts",
    "src/features/device/device-status-mapping.ts",
    "src/features/device/device-types.ts",
    "src/lib/api/errors.ts",
    "src/lib/i18n/translations.ts"
  ],
  "exclude": ["node_modules", ".test-dist"]
}

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/edvora

# Number of reverse-proxy hops in front of this process to trust when deriving the client IP
# from X-Forwarded-For (this is what auth-route rate limiting keys on - see
# src/infrastructure/http/trust-proxy.config.ts). Optional: defaults to 1 in production
# (Railway's single-hop edge) and 0 elsewhere. Only set this if the deployment topology adds or
# removes a proxy hop in front of Railway's own edge.
# TRUST_PROXY_HOPS=1

AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes-base64url
AUTH_JWT_ISSUER=edvora-api
AUTH_JWT_AUDIENCE=edvora-clients
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_WEB_ORIGINS=http://localhost:3000
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
MEDIA_DOCUMENTS_R2_ACCOUNT_ID=replace-with-cloudflare-account-id
MEDIA_DOCUMENTS_R2_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
MEDIA_DOCUMENTS_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
MEDIA_DOCUMENTS_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
MEDIA_DOCUMENTS_R2_BUCKET_NAME=replace-with-private-documents-bucket
MEDIA_DOCUMENTS_R2_UPLOAD_URL_TTL_SECONDS=600
MEDIA_DOCUMENTS_R2_DOWNLOAD_URL_TTL_SECONDS=300
MEDIA_VIDEO_BUNNY_STREAM_LIBRARY_ID=123456
MEDIA_VIDEO_BUNNY_STREAM_API_KEY=replace-with-bunny-stream-library-api-key
MEDIA_VIDEO_BUNNY_STREAM_WEBHOOK_SIGNING_SECRET=replace-with-bunny-stream-webhook-signing-secret
MEDIA_VIDEO_BUNNY_STREAM_TUS_UPLOAD_URL=https://video.bunnycdn.com/tusupload
MEDIA_VIDEO_BUNNY_STREAM_TUS_AUTHORIZATION_TTL_SECONDS=21600
MEDIA_VIDEO_BUNNY_STREAM_CDN_HOSTNAME=replace-with-bunny-pull-zone-hostname.b-cdn.net
MEDIA_VIDEO_BUNNY_STREAM_TOKEN_AUTHENTICATION_KEY=replace-with-bunny-pull-zone-token-authentication-key

# --- Manual Platform Admin bootstrap only (NOT normal runtime configuration) -----------------
# Consumed only by `pnpm --filter @edvora/api admin:bootstrap` (scripts/bootstrap-platform-admin.ts).
# The running API never reads these - do not set them as permanent service configuration.
# Set them just before running the bootstrap command once against a fresh environment, then
# unset/remove them again immediately afterward. See docs/DEPLOYMENT.md.
# PLATFORM_ADMIN_BOOTSTRAP_EMAIL=replace-with-the-first-admin-login-email
# PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-one-time-password
